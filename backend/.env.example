# Copy to backend/.env. Never commit the filled-in file.
DASHSCOPE_API_KEY=
ZHIPUAI_API_KEY=
COSYVOICE_VOICE_ID=
DASHSCOPE_WORKSPACE_ID=
COSYVOICE_MODEL=cosyvoice-v3.5-flash
QWEN_ASR_MODEL=qwen3-asr-flash
SERVER_IP=0.0.0.0
SERVER_PORT=5000
SPEAKER_VERIFICATION_ENABLED=true
# Optional absolute overrides; otherwise paths live under backend/.
# SV_MODEL_PATH=/opt/elysia/models/CAM++
# HF_HOME=/opt/elysia/cache/huggingface
# MODELSCOPE_CACHE=/opt/elysia/cache/modelscope
# TORCH_HOME=/opt/elysia/cache/torch
